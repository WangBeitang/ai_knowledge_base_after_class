# Cloud GRPO（云端群组相对策略优化）环境变量模板；不要写入真实密钥。

APP_ROOT=/root/autodl-tmp/ai_knowledge_base_after_class
BUSINESS_PYTHON_BIN=/root/autodl-tmp/ai_knowledge_base_after_class/.venv/bin/python
GRPO_PYTHON_BIN=/root/autodl-tmp/ai_knowledge_base_after_class/.venv-sft/bin/python
GRPO_CONFIG=evaluation/stage9/configs/planner_grpo_qwen3_5_4b_lora_formal.json
GRPO_SNAPSHOT=evaluation/stage9/artifacts/sft_v2/frozen_reviewed_75_v1/sft_v2_environment_snapshot.json
GRPO_PROVIDER_HOST=127.0.0.1
GRPO_PROVIDER_PORT=8021

# 模型和 tokenizer（分词器）必须已经在 HF_HOME（Hugging Face 缓存目录）中。
HF_HOME=/root/autodl-tmp/cache/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# 以下值由当前业务环境提供；使用真实 Provider（动作执行器），不能留空。
MILVUS_URL=
CHUNKS_COLLECTION=
MONGO_URL=
MONGO_DB_NAME=
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_DEFAULT_MODEL=
LLM_DEFAULT_TEMPERATURE=0
MCP_DASHSCOPE_BASE_URL=
BGE_M3_PATH=/root/autodl-tmp/models/bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=False
